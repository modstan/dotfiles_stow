[color]
        branch = auto
        diff = auto
        status = auto
        ui = true

[user]
        name = Modestas Stankus
	email = stankus.modestas@gmail.com
[core]
	sshCommand = ssh -i ~/.ssh/id_ed25519_personal

[alias]
        st = status
        co = checkout
        wc = whatchanged -p --i-still-use-this
        wr = whatchanged -p --reverse
        cm = commit --verbose
	br = branch
	am = am -s -p0
	sh = show --submodule=diff
	shs = show --stat
        serve = daemon --reuseaddr --base-path=. --export-all ./.git
	chp = cherry-pick -x -s
	np = log origin/master..master
	hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
	lg = log --no-merges --pretty=format:'%h %ad | %s%d [%an]' --date=short
	lgdiff = log --no-merges --pretty=format:'%s %d [%an]' --date=short
	ignored = status --ignored
	commited-ignored = !git ls-files -i --exclude-standard
[push]
	default = matching
	recurseSubmodules = on-demand
[merge]
	tool = meld
[diff]
	tool = icdiff
	#submodule = diff
	#noprefix = true
[difftool]
	prompt = false
[pager]
	difftool = true
[pull]
	rebase = true
[delta]
	navigate = true
	light = false
#[submodule]
#	recurse = 1
[status]
	submodulesummary = 1
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[includeIf "gitdir:~/projects/"]
	path = ~/.gitconfig_work


